# ==============================================================================
# Payment Twin - Environment Configuration Template
# Copy this file to `.env` for local development. Never commit real credentials.
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay API Credentials (Test or Production keys)
# Obtain these from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# Simulation & Modeling Engine Parameters
DEFAULT_SIMULATION_POPULATION=1000
DEFAULT_MONTE_CARLO_RUNS=50
SIMULATION_RANDOM_SEED=42
MAX_CONCURRENT_SIMULATIONS=4

# Payment Guardian (Drift & Anomaly Detection)
GUARDIAN_DRIFT_THRESHOLD_PSI=0.25
GUARDIAN_ALERT_SIGNIFICANCE_ALPHA=0.05
GUARDIAN_SLIDING_WINDOW_HOURS=24

# Persistence & Storage
DATABASE_URL=sqlite:///./payment_twin.db

# Frontend Application (Vite / React)
VITE_API_BASE_URL=http://localhost:8000
